# argoproj/argo-rollouts controller (:8090/metrics)
# Built from controller/metrics/prommetrics.go, metrics.go and rollouts.go: names,
# help and labels from source. Native exporter: go_*/process_* are not listed.
# `namespace` is the rollout's namespace; Prometheus renames it to
# `exported_namespace` when the scrape target already carries a namespace label.
# HELP rollout_info Information about rollout.
# TYPE rollout_info gauge
rollout_info{name="example-app",namespace="example-namespace",phase="Completed",strategy="canary",traffic_router=""} 1
rollout_info{name="example-failed",namespace="example-namespace",phase="Abort",strategy="blueGreen",traffic_router=""} 1
# HELP rollout_info_replicas_available The number of available replicas per rollout.
# TYPE rollout_info_replicas_available gauge
rollout_info_replicas_available{name="example-app",namespace="example-namespace"} 3
# HELP rollout_info_replicas_desired The number of desired replicas per rollout.
# TYPE rollout_info_replicas_desired gauge
rollout_info_replicas_desired{name="example-app",namespace="example-namespace"} 3
# HELP rollout_info_replicas_unavailable The number of unavailable replicas per rollout.
# TYPE rollout_info_replicas_unavailable gauge
rollout_info_replicas_unavailable{name="example-app",namespace="example-namespace"} 0
# HELP rollout_info_replicas_updated The number of updated replicas per rollout.
# TYPE rollout_info_replicas_updated gauge
rollout_info_replicas_updated{name="example-app",namespace="example-namespace"} 3
# HELP rollout_phase Information on the state of the rollout (DEPRECATED - use rollout_info)
# TYPE rollout_phase gauge
rollout_phase{name="example-app",namespace="example-namespace",phase="Completed",strategy="canary"} 1
rollout_phase{name="example-app",namespace="example-namespace",phase="Progressing",strategy="canary"} 0
rollout_phase{name="example-app",namespace="example-namespace",phase="Paused",strategy="canary"} 0
rollout_phase{name="example-app",namespace="example-namespace",phase="Timeout",strategy="canary"} 0
rollout_phase{name="example-app",namespace="example-namespace",phase="Error",strategy="canary"} 0
rollout_phase{name="example-app",namespace="example-namespace",phase="Abort",strategy="canary"} 0
# HELP rollout_reconcile Rollout reconciliation performance.
# TYPE rollout_reconcile histogram
rollout_reconcile_bucket{name="example-app",namespace="example-namespace",le="0.01"} 10
rollout_reconcile_bucket{name="example-app",namespace="example-namespace",le="0.15"} 40
rollout_reconcile_bucket{name="example-app",namespace="example-namespace",le="0.25"} 48
rollout_reconcile_bucket{name="example-app",namespace="example-namespace",le="0.5"} 50
rollout_reconcile_bucket{name="example-app",namespace="example-namespace",le="1"} 50
rollout_reconcile_bucket{name="example-app",namespace="example-namespace",le="+Inf"} 50
rollout_reconcile_sum{name="example-app",namespace="example-namespace"} 6.2
rollout_reconcile_count{name="example-app",namespace="example-namespace"} 50
# HELP rollout_reconcile_error Error occurring during the rollout
# TYPE rollout_reconcile_error counter
rollout_reconcile_error{name="example-app",namespace="example-namespace"} 0
# HELP rollout_events_total Count of rollout events
# TYPE rollout_events_total counter
rollout_events_total{name="example-app",namespace="example-namespace",reason="RolloutCompleted",type="Normal"} 1
# HELP analysis_run_info Information about analysis run.
# TYPE analysis_run_info gauge
analysis_run_info{name="example-app-analysis",namespace="example-namespace",phase="Successful"} 1
# HELP analysis_run_reconcile_error Error occurring during the analysis run
# TYPE analysis_run_reconcile_error counter
analysis_run_reconcile_error{name="example-app-analysis",namespace="example-namespace"} 0
# HELP experiment_reconcile_error Error occurring during the experiment
# TYPE experiment_reconcile_error counter
experiment_reconcile_error{name="example-experiment",namespace="example-namespace"} 0
# HELP notification_send_error Error sending the notification
# TYPE notification_send_error counter
notification_send_error{name="example-app",namespace="example-namespace",reason="example",type="slack"} 0
# HELP argo_rollouts_controller_info Running Argo-rollouts version
# TYPE argo_rollouts_controller_info gauge
argo_rollouts_controller_info{version="v1.8.0"} 1
# HELP build_info A metric with a constant '1' value labeled by version from which Argo-Rollouts was built.
# TYPE build_info gauge
build_info{commit="0000000",goarch="amd64",goversion="go1.24",version="v1.8.0"} 1
